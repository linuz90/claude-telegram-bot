# Claude Telegram Bot - Environment Configuration
#
#   cp .env.example .env
#
# Secrets and tunables only. The container's paths (CLAUDE_WORKING_DIR,
# STATE_DIR) are set in deployment/Dockerfile and are part of the image layout -
# do not override them here.

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs allowed to use the bot.
# This is the security perimeter - see docs/security.md.
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=123456789

# Provider credential. ANTHROPIC_AUTH_TOKEN works as an alias.
KIMI_API_KEY=

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# OpenAI API key for voice and audio transcription.
# Without this, voice messages and audio files are rejected.
OPENAI_API_KEY=sk-...

# ==============================================================================
# DEPLOY HOST
# ==============================================================================
# See "Permissions on the deploy host" in README.md.

# Host directory bind-mounted at /app/agent/data. Everything that must survive a redeploy
# lives here. Defaults to ./data, which is fine locally; on a real host point it
# somewhere outside the repository.
# STATE_PATH=/srv/claude-telegram/data

# The uid/gid the container runs as. Must be able to write to STATE_PATH.
# Defaults to 1000:1000. Required on Linux when your user is not uid 1000.
# HOST_UID=1000
# HOST_GID=1000

# ==============================================================================
# OPTIONAL - LLM Provider
# ==============================================================================
# Everything here has a working default; only the key above is required.
# Background: docs/provider.md

# Endpoint. Override this together with the model variables to point at another
# Anthropic-compatible provider, OpenRouter included.
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic

# The three tiers Claude Code resolves "opus", "sonnet" and "haiku" through.
# "[1m]" selects the 1M context window. Leave opus and haiku empty and they
# follow sonnet; point haiku at something cheaper (kimi-k2.6) if the internal
# small/fast calls are not worth the sonnet tier.
# BOT_MODEL_SONNET=kimi-k3[1m]
# BOT_MODEL_OPUS=
# BOT_MODEL_HAIKU=

# Which tier this session runs on: opus, sonnet or haiku. A raw model name also
# works, but then skips the tier mapping for the main loop.
# BOT_MODEL_MAIN=sonnet

# Reasoning effort: an integer, or low/medium/high. Kimi's guide says "max",
# which this SDK version rejects and silently treats as unset.
# BOT_EFFORT_LEVEL=high

# Compatibility escape hatches. Leave false. Set the first to true only if a
# model returns a 400 naming the "thinking" field, the second if it names
# another unrecognised request field.
# BOT_DISABLE_ADAPTIVE_THINKING=false
# BOT_DISABLE_EXPERIMENTAL_BETAS=false

# ==============================================================================
# OPTIONAL - Rate limiting
# ==============================================================================
# Token bucket, per user.

# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# OPTIONAL - Extended Thinking
# ==============================================================================

# Keywords that trigger extended thinking (comma-separated, case-insensitive)
# THINKING_KEYWORDS=think,pensa,ragiona

# Keywords that trigger deep thinking (50k tokens)
# THINKING_DEEP_KEYWORDS=ultrathink,think hard,pensa bene

# ==============================================================================
# OPTIONAL - Voice Transcription
# ==============================================================================

# A file with extra context for transcription: names, jargon, product terms.
# Must be a path inside the container, so put the file in agent/ and point at
# /app/agent/<name>.
# TRANSCRIPTION_CONTEXT_FILE=/app/agent/transcription-context.txt

# ==============================================================================
# OPTIONAL - Logging
# ==============================================================================

# Audit log path. Defaults to $STATE_DIR/claude-telegram-audit.log, which is on
# the volume. Moving it off the volume means losing it on redeploy.
# AUDIT_LOG_PATH=/app/agent/data/claude-telegram-audit.log

# Output audit logs as JSON (default: human-readable)
# AUDIT_LOG_JSON=false
